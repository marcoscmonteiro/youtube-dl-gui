<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Backgrounds -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F8FAFC" /> <!-- Slate 50 -->
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF" /> <!-- White -->
    <SolidColorBrush x:Key="CardBackgroundHoverBrush" Color="#F1F5F9" /> <!-- Slate 100 -->
    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#F1F5F9" />
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="HeaderBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="StatusBarBackgroundBrush" Color="#E2E8F0" />

    <!-- Borders -->
    <SolidColorBrush x:Key="BorderBrush" Color="#CBD5E1" />
    <SolidColorBrush x:Key="BorderFocusBrush" Color="#0284C7" />
    <SolidColorBrush x:Key="DividerBrush" Color="#E2E8F0" />

    <!-- Text -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#0F172A" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#475569" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#94A3B8" />
    <SolidColorBrush x:Key="TextOnAccentBrush" Color="#FFFFFF" />

    <!-- Accents -->
    <SolidColorBrush x:Key="AccentBrush" Color="#0284C7" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#0369A1" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#075985" />
    <SolidColorBrush x:Key="AccentLightBrush" Color="#0284C7" />

    <!-- Status Colors -->
    <SolidColorBrush x:Key="SuccessBrush" Color="#10B981" />
    <SolidColorBrush x:Key="WarningBrush" Color="#F59E0B" />
    <SolidColorBrush x:Key="DangerBrush" Color="#EF4444" />
    <SolidColorBrush x:Key="InfoBrush" Color="#0284C7" />

    <!-- Scrollbar & Progress -->
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="#CBD5E1" />
    <SolidColorBrush x:Key="ProgressBarTrackBrush" Color="#E2E8F0" />
    <SolidColorBrush x:Key="ProgressBarFillBrush" Color="#0284C7" />

</ResourceDictionary>
