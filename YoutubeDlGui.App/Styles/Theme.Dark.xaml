<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Backgrounds -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#0F172A" /> <!-- Slate 900 -->
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#1E293B" /> <!-- Slate 800 -->
    <SolidColorBrush x:Key="CardBackgroundHoverBrush" Color="#334155" /> <!-- Slate 700 -->
    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#0F172A" />
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#0F172A" />
    <SolidColorBrush x:Key="HeaderBackgroundBrush" Color="#1E293B" />
    <SolidColorBrush x:Key="StatusBarBackgroundBrush" Color="#0B1120" />

    <!-- Borders -->
    <SolidColorBrush x:Key="BorderBrush" Color="#334155" />
    <SolidColorBrush x:Key="BorderFocusBrush" Color="#38BDF8" />
    <SolidColorBrush x:Key="DividerBrush" Color="#334155" />

    <!-- Text -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F8FAFC" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#94A3B8" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#64748B" />
    <SolidColorBrush x:Key="TextOnAccentBrush" Color="#FFFFFF" />

    <!-- Accents -->
    <SolidColorBrush x:Key="AccentBrush" Color="#0284C7" /> <!-- Sky 600 -->
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#0369A1" /> <!-- Sky 700 -->
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#075985" /> <!-- Sky 800 -->
    <SolidColorBrush x:Key="AccentLightBrush" Color="#38BDF8" />

    <!-- Status Colors -->
    <SolidColorBrush x:Key="SuccessBrush" Color="#10B981" />
    <SolidColorBrush x:Key="WarningBrush" Color="#F59E0B" />
    <SolidColorBrush x:Key="DangerBrush" Color="#EF4444" />
    <SolidColorBrush x:Key="InfoBrush" Color="#0284C7" />

    <!-- Scrollbar & Progress -->
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="#475569" />
    <SolidColorBrush x:Key="ProgressBarTrackBrush" Color="#0F172A" />
    <SolidColorBrush x:Key="ProgressBarFillBrush" Color="#38BDF8" />

</ResourceDictionary>
