<Window x:Class="YoutubeDlGui.App.Views.HelpOptionsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Opções de Ajuda da Engine" Height="580" Width="800"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Text="Parâmetros e Opções da Linha de Comando" FontSize="16" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,10"/>

        <!-- Search input -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="TextBoxSearch" Style="{DynamicResource ModernTextBox}" 
                     Text="{Binding SearchTerm, UpdateSourceTrigger=PropertyChanged}"
                     Padding="10,6" KeyDown="TextBoxSearch_KeyDown"/>
            <Button Grid.Column="1" Content="Buscar" Style="{DynamicResource SecondaryButton}" Margin="8,0,0,0" Click="Search_Click"/>
        </Grid>

        <!-- Help Content -->
        <Border Grid.Row="2" Background="{DynamicResource CardBackgroundBrush}" 
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6">
            <TextBox x:Name="TextBoxHelp" IsReadOnly="True" TextWrapping="Wrap"
                     FontFamily="Consolas, Cascadia Code, Courier New" FontSize="12"
                     Background="Transparent" Foreground="{DynamicResource TextPrimaryBrush}"
                     BorderThickness="0" Padding="10" VerticalScrollBarVisibility="Auto"/>
        </Border>

        <!-- Footer -->
        <Grid Grid.Row="3" Margin="0,12,0,0">
            <TextBlock VerticalAlignment="Center">
                <Hyperlink NavigateUri="https://github.com/yt-dlp/yt-dlp#usage-and-options" RequestNavigate="Hyperlink_RequestNavigate">
                    Documentação Oficial do yt-dlp no GitHub
                </Hyperlink>
            </TextBlock>
            <Button HorizontalAlignment="Right" Content="Fechar" Style="{DynamicResource AccentButton}" Click="Close_Click"/>
        </Grid>
    </Grid>
</Window>
