<Window x:Class="YoutubeDlGui.App.Views.LogViewerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Log de Download" Height="500" Width="700"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock x:Name="TextTitle" Text="Detalhes e Saída do Processo" FontSize="16" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12"/>

        <!-- Monospace Log Box -->
        <Border Grid.Row="1" Background="{DynamicResource CardBackgroundBrush}" 
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6">
            <TextBox x:Name="TextBoxLog" IsReadOnly="True" TextWrapping="Wrap"
                     FontFamily="Consolas, Cascadia Code, Courier New" FontSize="12"
                     Background="Transparent" Foreground="{DynamicResource TextPrimaryBrush}"
                     BorderThickness="0" Padding="10" VerticalScrollBarVisibility="Auto"
                     CaretBrush="{DynamicResource AccentLightBrush}"/>
        </Border>

        <!-- Bottom Actions -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Copiar Log" Style="{DynamicResource SecondaryButton}" Margin="0,0,8,0" Click="CopyLog_Click"/>
            <Button Content="Fechar" Style="{DynamicResource AccentButton}" Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
